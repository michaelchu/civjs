          "name": "NoPollution",
          "range": "Tile",
          "present": false
        }
      ],
      "removal_time": 0,
      "flags": "GlobalWarming",
      "helptext": [
        "Pollution appears on tiles around cities with high production. It halves all output from its tile.",
        "The pollution can only be cleared by dispatching Engineer or Hunter units with the \"clean pollution\" order.",
        "The contribution of production to pollution can be seen in the city dialog; once it exceeds a threshold, the excess is the percent chance of pollution appearing each turn."
      ]
    },
    "extra_capsule": {
      "name": "Space Capsule",
      "category": "Bonus",
      "causes": "Hut",
      "rmcauses": "Enter",
      "graphic": "tx.capsule",
      "graphic_alt": "tx.village",
      "activity_gfx": "None",
      "act_gfx_alt": "-",
      "act_gfx_alt2": "-",
