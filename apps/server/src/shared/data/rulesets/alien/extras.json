      "build_time": 0,
      "removal_time": 0,
      "conflicts": ["Irrigation", "Farmland"],
      "helptext": "Mines can be built on Hills for an extra production point. Once Burrowing is known, Thick Mountains can also be mined."
    },
    "extra_pollution": {
      "name": "Pollution",
      "category": "Nuisance",
