    "extra_pollution": {
      "name": "Pollution",
      "category": "Nuisance",
      "causes": "Pollution",
      "rmcauses": "Clean",
      "graphic": "tx.pollution",
      "graphic_alt": "-",
      "activity_gfx": "None",
