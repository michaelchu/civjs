# Server URL (optional - Railway can auto-set this)
# 
# RECOMMENDED: In Railway, set this environment variable to reference your backend service:
# VITE_SERVER_URL=https://${{ YOUR_BACKEND_SERVICE_NAME.RAILWAY_PUBLIC_DOMAIN }}
# 
# Replace YOUR_BACKEND_SERVICE_NAME with your actual Railway backend service name.
# Based on your example URL (civjs-frontend-civjs-pr-158.up.railway.app), try:
# VITE_SERVER_URL=https://${{ backend.RAILWAY_PUBLIC_DOMAIN }}
#
# NOTE: RAILWAY_PUBLIC_DOMAIN is required (not RAILWAY_PRIVATE_DOMAIN) because:
# - Browser clients cannot access Railway private networks
# - Public domain is needed for client-to-server communication
# - Railway warning about egress fees is expected for frontend-to-backend connections
#
# This automatically resolves to the correct backend URL for both:
# - Preview environments (e.g., civjs-backend-civjs-pr-158.up.railway.app)  
# - Production environments (e.g., civjs-backend.up.railway.app)
#
# If not set, will use browser-based URL detection as fallback
VITE_SERVER_URL=https://your-civjs-server.vercel.app