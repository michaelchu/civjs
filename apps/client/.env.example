# Server URL (optional - Railway can auto-set this)
# 
# RECOMMENDED: In Railway, set this environment variable to:
# VITE_SERVER_URL=https://${{ backend.RAILWAY_PUBLIC_DOMAIN }}
# 
# This automatically resolves to the correct backend URL for both:
# - Preview environments (e.g., civjs-backend-civjs-pr-158.up.railway.app)
# - Production environments (e.g., civjs-backend.up.railway.app)
#
# If not set, will use browser-based URL detection as fallback
VITE_SERVER_URL=https://your-civjs-server.vercel.app