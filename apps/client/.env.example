# Server URL (optional - Railway auto-provides preview URLs)
# 
# RECOMMENDED APPROACH: Railway automatically provides PREVIEW_BACKEND_URL
# Set this environment variable in Railway to use the Railway-provided URL:
# VITE_PREVIEW_BACKEND_URL=${{ PREVIEW_BACKEND_URL }}
#
# ALTERNATIVE: Manually reference your backend service:
# VITE_SERVER_URL=https://${{ YOUR_BACKEND_SERVICE_NAME.RAILWAY_PUBLIC_DOMAIN }}
#
# PRIORITY ORDER:
# 1. VITE_SERVER_URL (if set) - manual override
# 2. VITE_PREVIEW_BACKEND_URL (if set) - Railway preview environments  
# 3. Fallback to production URL - https://civjs.up.railway.app
#
# NOTE: Must use public domains for browser clients (egress fees expected)
VITE_SERVER_URL=https://your-civjs-server.vercel.app