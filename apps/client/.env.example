# Server URL (optional - if not set, will auto-detect Railway preview URLs)
# For Railway previews, the client will automatically construct the server URL
# by replacing 'frontend' with 'backend' in the current domain
# Example: civjs-frontend-civjs-pr-158.up.railway.app → civjs-backend-civjs-pr-158.up.railway.app
VITE_SERVER_URL=https://your-civjs-server.vercel.app