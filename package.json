{
  "name": "civjs-monorepo",
  "version": "1.0.0",
  "description": "CivJS - A modern civilization game built with TypeScript, React, and Node.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd apps/client && npm run dev",
    "dev:server": "cd apps/server && npm run dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd apps/client && npm run build",
    "build:server": "cd apps/server && npm run build",
    "start:prod": "cd apps/server && npm run start:prod",
    "test": "npm run test:unit",
    "test:unit": "npm run test:unit:client && npm run test:unit:server",
    "test:unit:client": "cd apps/client && npm run test",
    "test:unit:server": "cd apps/server && npm run test:unit",
    "test:integration": "node tools/run-integration-tests.mjs",
    "test:integration:direct": "cd apps/server && npm run test:integration",
    "test:ai-validation": "INTEGRATION_TEST_PATH=tests/integration/AIManagerBoundaries.integration.test.ts node tools/run-integration-tests.mjs",
    "test:ai-validation:matrix": "AI_VALIDATION_SEED_COUNT=25 AI_VALIDATION_MAX_TURNS=4 INTEGRATION_TEST_NAME_PATTERN='terminal turn limit' INTEGRATION_TEST_PATH=tests/integration/AIManagerBoundaries.integration.test.ts node tools/run-integration-tests.mjs",
    "test:ai-validation:100": "AI_VALIDATION_SEED_COUNT=100 AI_VALIDATION_MAX_TURNS=4 INTEGRATION_TEST_NAME_PATTERN='terminal turn limit' INTEGRATION_TEST_PATH=tests/integration/AIManagerBoundaries.integration.test.ts node tools/run-integration-tests.mjs",
    "test:ai-validation:long": "AI_VALIDATION_SEED_COUNT=25 AI_VALIDATION_MAX_TURNS=12 INTEGRATION_TEST_NAME_PATTERN='terminal turn limit' INTEGRATION_TEST_PATH=tests/integration/AIManagerBoundaries.integration.test.ts node tools/run-integration-tests.mjs",
    "simulation:run": "cd apps/server && npm run --silent simulation:run --",
    "simulation:run:scenarios": "node tools/run-simulation-scenarios.mjs",
    "test:integration:path": "cd apps/server && npm run test:integration:path --",
    "test:integration:watch": "cd apps/server && npm run test:integration:watch",
    "test:all": "npm run test:unit && npm run test:integration",
    "setup:worktree": "bash scripts/setup-worktree.sh",
    "verify": "npm run check:module-docs && npm run check:test-evidence && npm run check:civ2civ3-action-evidence && npm run check:civ2civ3-nations && npm run format:check && npm run lint && npm run typecheck && npm run test:unit",
    "check:module-docs": "node tools/check-module-docs.mjs",
    "check:test-evidence": "node tools/check-test-evidence.mjs",
    "check:civ2civ3-nations": "node tools/convert-rulesets.mjs civ2civ3 --check --only=nations",
    "check:civ2civ3-oracle": "node tools/run-freeciv-oracle.mjs --check",
    "check:civ2civ3-action-evidence": "node tools/audit-civ2civ3-parity.mjs --actions-only",
    "audit:civ2civ3-parity": "node tools/audit-civ2civ3-parity.mjs",
    "certify:civ2civ3-parity": "node tools/convert-rulesets.mjs civ2civ3 --check --diff && node tools/audit-civ2civ3-parity.mjs --strict",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "backup:create": "node tools/postgres-backup.mjs create",
    "backup:verify": "node tools/postgres-backup.mjs verify",
    "lint": "npm run lint:client && npm run lint:server",
    "lint:client": "cd apps/client && npm run lint",
    "lint:server": "cd apps/server && npm run lint",
    "lint:fix": "npm run lint:fix:client && npm run lint:fix:server",
    "lint:fix:client": "cd apps/client && npm run lint:fix",
    "lint:fix:server": "cd apps/server && npm run lint:fix",
    "format": "npm run format:root && npm run format:client && npm run format:server",
    "format:root": "prettier --write \"package.json\" \"playwright.config.ts\" \"docker-compose.test.yml\" \".github/**/*.yml\" \"docs/**/*.md\" \"tests/**/*.ts\" \"tools/**/*.mjs\"",
    "format:client": "cd apps/client && npm run format",
    "format:server": "cd apps/server && npm run format",
    "format:check": "npm run format:check:root && npm run format:check:client && npm run format:check:server",
    "format:check:root": "prettier --check \"package.json\" \"playwright.config.ts\" \"docker-compose.test.yml\" \".github/**/*.yml\" \"docs/**/*.md\" \"tests/**/*.ts\" \"tools/**/*.mjs\"",
    "format:check:client": "cd apps/client && npm run format:check",
    "format:check:server": "cd apps/server && npm run format:check",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "typecheck:client": "cd apps/client && npm run type-check",
    "typecheck:server": "cd apps/server && npm run type-check",
    "clean": "rm -rf apps/client/dist apps/server/dist",
    "clean:deps": "rm -rf node_modules apps/client/node_modules apps/server/node_modules",
    "docker:up": "docker-compose up",
    "docker:build": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "concurrently": "^9.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:michaelchu/civjs.git"
  },
  "keywords": [
    "civilization",
    "game",
    "typescript",
    "react",
    "nodejs",
    "socket.io",
    "canvas",
    "freeciv"
  ],
  "author": "Michael Chu",
  "license": "MIT",
  "dependencies": {
    "zod": "^4.1.5"
  },
  "lint-staged": {
    "playwright.config.ts": [
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "prettier --write"
    ],
    "tools/**/*.mjs": [
      "prettier --write"
    ],
    "apps/client/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/server/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
